rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user reads and writes only their own progress document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else (config/ai, aiUsage, aiLog) is used only by the AI server, never by the app.
  }
}
